# ==================== POSTGRES ====================
POSTGRES_USER=tests
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tests
POSTGRES_PORT=5432

# ==================== BACKEND ====================
# Внутри docker-compose сеть резолвит имя сервиса "db"
DATABASE_URL=postgresql+psycopg2://tests:change_me_strong_password@db:5432/tests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Секрет для JWT (auth.py) — сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_random_string

# ==================== SMTP (mailer.py) ====================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@yandex.ru
RESEND_API_KEY = change_me_api_key
FROM_EMAIL = your_email@yandex.ru
CODE_TTL_MINUTES = 10

# ==================== FRONTEND ====================
# Порт, на котором Nginx будет слушать снаружи
APP_PORT=80