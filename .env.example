# ==================== POSTGRES ====================

POSTGRES_USER=tests
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tests
POSTGRES_PORT=5432
# Внутри docker-compose сеть резолвит имя сервиса "db"
DATABASE_URL=postgresql+psycopg2://tests:change_me_strong_password@db:5432/tests

# ==================== BACKEND ====================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Срок жизни кода из письма (минуты)
CODE_TTL_MINUTES=10
# Секрет для JWT (auth.py) — сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=strong-secret

# ==================== EMAIL (Яндекс) mailer.py============

EMAIL_ENABLED=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=Ваш почтовый адрес@yandex.ru
SMTP_PASSWORD=Ваш пароль от приложения в yandex(выдается отдельно в passport.yandex.ru/profile/access)
SMTP_FROM=Ваш почтовый адрес@yandex.ru

# ==================== FRONTEND ====================
# Порт, на котором Nginx будет слушать снаружи
APP_PORT=80